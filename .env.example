# PostgreSQL connection used by server-side migrations, seeding and application data access.
# Use a pooled or direct hosted PostgreSQL URL appropriate to the environment.
DATABASE_URL=

# Optional. Defaults to eight hours; keep server-side session expiry short for sensitive records.
AUTH_SESSION_TTL_HOURS=8

# Used only by the explicit password-provisioning command. Never commit a real value.
AURELIA_PASSWORD=

# Integration tests require an isolated database whose name contains "test" or "dev".
# Set the opt-in flag only after confirming that database can be safely cleaned up.
AURELIA_INTEGRATION_DATABASE_URL=
AURELIA_RUN_INTEGRATION=0
